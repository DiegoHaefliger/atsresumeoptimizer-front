{
  "manifest_version": 3,
  "name": "ATS Resume Optimizer - Perfil do LinkedIn",
  "version": "0.1.0",
  "description": "Lê o seu próprio perfil aberto no LinkedIn e envia para o ATS Resume Optimizer analisar.",
  "permissions": ["activeTab", "scripting", "storage"],
  "host_permissions": ["http://localhost/*", "http://127.0.0.1/*", "https://media.licdn.com/*"],
  "action": {
    "default_title": "Analisar meu LinkedIn",
    "default_popup": "popup.html"
  },
  "icons": {
    "128": "icons/icon.png"
  }
}
